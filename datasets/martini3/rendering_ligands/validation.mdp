; Preprocessing-only rendering fixture; no dynamics or minimization claimed.
integrator = md
dt = 0.001
nsteps = 0
cutoff-scheme = Verlet
coulombtype = Reaction-Field
rcoulomb = 1.1
epsilon-r = 15
epsilon-rf = 0
vdwtype = Cut-off
vdw-modifier = Potential-shift-Verlet
rvdw = 1.1
rlist = 1.1
constraints = none
nstlist = 20
verlet-buffer-tolerance = -1
nstcomm = 0
gen-vel = no
