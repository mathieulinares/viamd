; Bonded Martini rendering panel; unsolvated and not equilibrated for dynamics.
integrator               = steep
nsteps                   = 0
emtol                    = 1000000
emstep                   = 0.001
nstlist                  = 20
cutoff-scheme            = Verlet
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
vdwtype                  = cut-off
rvdw                     = 1.1
pbc                      = xyz
constraints              = none
nstenergy                = 1
nstlog                   = 1
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
