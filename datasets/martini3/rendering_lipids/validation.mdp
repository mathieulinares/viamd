; Preprocessing-only validation, not a production simulation protocol.
integrator = steep
nsteps = 0
dt = 0.002
cutoff-scheme = Verlet
nstlist = 20
coulombtype = Cut-off
rcoulomb = 1.1
epsilon_r = 15
vdwtype = Cut-off
vdw-modifier = Potential-shift-verlet
rvdw = 1.1
rlist = 1.1
pbc = xyz
constraints = none
gen-vel = no
